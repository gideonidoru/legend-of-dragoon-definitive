[Desktop Entry]
Type=Application
Name=Install Legend of Dragoon: Definitive
Comment=Guided Steam Deck setup with visible startup diagnostics
Icon=applications-games
Terminal=true
Exec=/bin/bash -c "set -o pipefail; umask 077; mkdir -p ~/.cache/legend-of-dragoon-definitive; (echo Legend of Dragoon - Definitive setup; mktemp -d /tmp/definitive-installer.XXXXXX | xargs -I DEF_STAGE /usr/bin/env -C DEF_STAGE /bin/bash -c 'set -euo pipefail; cleanup() { mv -fT desktop-bootstrap.log ~/.cache/legend-of-dragoon-definitive/desktop-bootstrap.log; rm -f install.sh; pwd | xargs rmdir; }; trap cleanup EXIT; (echo Downloading the verified installer; curl --fail --location --show-error --proto =https --proto-redir =https --retry 2 --connect-timeout 20 --max-time 180 --output install.sh https://github.com/gideonidoru/legend-of-dragoon-definitive/releases/download/definitive-alpha-2026-10-10-modelshd/Install-Definitive.sh; sha256sum install.sh | grep -q ^77402964568407b641e91a57c330f01b2ed93044255c47370e919432bff4c3e2 || { echo Installer checksum mismatch. No installer was launched.; exit 1; }; /bin/bash install.sh) 2>&1 | tee desktop-bootstrap.log') 2>&1 || { echo Setup could not start.; echo Diagnostic logs:; echo ~/.cache/legend-of-dragoon-definitive/desktop-bootstrap.log; echo ~/.cache/legend-of-dragoon-definitive/installer-bootstrap.log; echo ~/.cache/legend-of-dragoon-definitive/installer.log; echo Press Enter to close.; read -r; exit 1; }"
Categories=Game;
